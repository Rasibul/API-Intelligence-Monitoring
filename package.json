{
  "name": "api-intelligence-monitoring",
  "version": "0.1.0",
  "private": true,
  "description": "Private API Intelligence & Monitoring backend",
  "type": "module",
  "engines": {
    "node": "^22.21.0 || ^24.10.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/app/server.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test": "node --import tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
