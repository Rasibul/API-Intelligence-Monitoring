NODE_ENV=development
PORT=5000
# Comma-separated exact origins: scheme, host and port only.
CORS_ORIGIN=http://localhost:5173

# Placeholders only. Never commit real hosts or credentials.
# MongoDB Atlas: the database name in the path is mandatory, and this
# computer's public IP must be in Atlas Network Access. Transactions planned
# for later steps need a replica set; a standalone server cannot provide them.
MONGODB_URI=mongodb+srv://app_user:change-me@cluster0.example.mongodb.net/api_monitoring_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# The URL only: remove any "redis-cli -u" prefix copied from a console.
# Use rediss:// (TLS). Plaintext redis:// sends the password unencrypted.
# Query parameters are rejected.
REDIS_URL=rediss://default:change-me@redis.example.com:6380
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_DELAY_MS=5000

# Connection attempts per dependency before startup fails.
STARTUP_MAX_ATTEMPTS=3

# Bearer credential for GET /ready: 32+ random URL-safe characters.
# Blank disables the endpoint; required when NODE_ENV=production.
WATCHDOG_TOKEN=
